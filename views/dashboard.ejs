<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>👑 RINTU - INFINITE TOKENS</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:#0a0a0a; color:#00ffc8; font-family:monospace; padding:20px; }
        .container { max-width:700px; margin:0 auto; }
        h1 { color:#ff0040; text-align:center; font-size:2rem; }
        .sub { color:#666; text-align:center; margin-bottom:15px; }
        .glass { background:rgba(10,10,10,0.8); border:1px solid rgba(0,255,200,0.1); border-radius:12px; padding:15px; margin:10px 0; }
        .grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; }
        .stat { text-align:center; padding:10px; border:1px solid rgba(0,255,200,0.05); border-radius:8px; }
        .stat .label { color:#666; font-size:0.6rem; text-transform:uppercase; }
        .stat .value { font-size:1.5rem; font-weight:bold; }
        .gold { color:#ff8800; }
        .green { color:#00ff88; }
        input, textarea { background:rgba(0,0,0,0.6); color:#00ffc8; border:1px solid rgba(0,255,200,0.1); padding:8px; width:100%; border-radius:6px; margin:4px 0; font-family:monospace; }
        textarea { min-height:150px; resize:vertical; font-size:0.8rem; }
        .btn { background:rgba(0,255,200,0.08); color:#00ffc8; border:1px solid rgba(0,255,200,0.15); padding:6px 12px; border-radius:6px; cursor:pointer; font-size:0.7rem; }
        .btn:hover { background:rgba(0,255,200,0.15); }
        .btn.danger { border-color:rgba(255,0,64,0.3); color:#ff0040; }
        .btn.primary { background:#ff8800; color:#000; border:none; padding:8px 16px; font-weight:bold; cursor:pointer; border-radius:6px; }
        .btn.gold { border-color:#ffcc00; color:#ffcc00; }
        .btn.green { border-color:#00ff88; color:#00ff88; }
        .flex { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
        .token-item { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px solid rgba(0,255,200,0.05); font-size:0.65rem; align-items:center; }
        .status { padding:2px 8px; border-radius:8px; font-size:0.5rem; font-weight:bold; }
        .status.on { background:rgba(0,255,200,0.15); color:#00ffc8; }
        .status.off { background:rgba(255,0,64,0.15); color:#ff0040; }
        .token-list { max-height:200px; overflow-y:auto; margin-top:8px; }
        #logs { background:rgba(0,0,0,0.3); border-radius:8px; padding:8px; max-height:80px; overflow-y:auto; font-size:0.6rem; color:#666; margin-top:10px; }
        .hidden { display:none; }
        .online-count { color:#00ff88; font-weight:bold; }
        .bulk-section { border-top:1px solid rgba(255,204,0,0.1); padding-top:10px; margin-top:10px; }
        ::-webkit-scrollbar { width:3px; background:transparent; }
        ::-webkit-scrollbar-thumb { background:#00ffc8; border-radius:3px; }
        .small-text { font-size:0.6rem; color:#666; }
        .progress-bar { background:rgba(0,0,0,0.3); border-radius:6px; padding:4px 8px; margin-top:5px; font-size:0.7rem; }
    </style>
</head>
<body>
<div class="container">
    <h1>👑 RINTU</h1>
    <div class="sub">INFINITE TOKENS • BULK ADD ANY AMOUNT</div>

    <div class="glass">
        <div class="flex" style="justify-content:space-between;">
            <span>🤖 <span id="onlineCount" class="online-count">0</span> online</span>
            <span>📦 <span id="tokenCount">0</span> tokens</span>
            <span>✅ <span id="enabledCount">0</span> enabled</span>
            <button class="btn danger" onclick="logout()">LOGOUT</button>
        </div>
    </div>

    <div class="grid">
        <div class="stat"><div class="label">Total</div><div class="value" id="statTokens">0</div></div>
        <div class="stat"><div class="label">Enabled</div><div class="value gold" id="statEnabled">0</div></div>
        <div class="stat"><div class="label">Online</div><div class="value" id="statOnline">0</div></div>
    </div>

    <!-- INFINITE BULK ADD SECTION -->
    <div class="glass" style="border-color:rgba(255,204,0,0.2);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
            <span style="color:#ffcc00; font-weight:bold;">📦 INFINITE BULK ADD</span>
            <span class="small-text">Paste ALL your tokens here</span>
        </div>
        <textarea id="bulkTokensInput" placeholder="MTIzNDU2Nzg5MDEyMzQ1Njc4OQ&#10;NDU2Nzg5MDEyMzQ1Njc4OTA&#10;NzgyOTAxMjM0NTY3ODkwMQ&#10;... and more"></textarea>
        <div class="flex" style="margin-top:5px;">
            <input type="text" id="bulkOwnerInput" placeholder="Default owner (optional)" style="flex:1;">
            <button class="btn gold" onclick="bulkAdd()" style="flex:1;">📦 BULK ADD</button>
            <button class="btn green" onclick="bulkAddAndStart()" style="flex:1;">🚀 ADD & START</button>
        </div>
        <div id="bulkProgress" class="progress-bar" style="display:none;"></div>
        <div id="bulkResult" style="font-size:0.7rem; color:#888; margin-top:5px;"></div>
    </div>

    <div class="glass">
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
            <input type="text" id="tokenInput" placeholder="Or add single token" style="flex:2;">
            <input type="text" id="ownerInput" placeholder="Owner" style="flex:1;">
            <button class="btn primary" onclick="addToken()">ADD</button>
        </div>
        <div style="display:flex; gap:6px; margin-top:5px; flex-wrap:wrap;">
            <button class="btn" onclick="startAll()" style="border-color:#00ffc8; color:#00ffc8;">▶ START ALL</button>
            <button class="btn danger" onclick="stopAll()">⏹ STOP ALL</button>
            <button class="btn" onclick="loadTokens()">🔄 REFRESH</button>
            <button class="btn danger" onclick="clearAll()">🗑️ CLEAR ALL</button>
        </div>
        <div class="token-list" id="tokenList"></div>
    </div>

    <div class="glass">
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
            <input type="text" id="vcChannel" placeholder="Voice Channel ID" style="flex:2;">
            <button class="btn" onclick="joinVC()" style="border-color:#ff8800; color:#ff8800;">🔊 JOIN VC</button>
        </div>
        <div id="vcStatus" style="color:#666; font-size:0.7rem; margin-top:4px;"></div>
    </div>

    <div id="logs"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    let socket = io();

    // ─── LOGIN/LOGOUT ───
    function logout() {
        fetch('/api/logout', { method: 'POST' }).then(() => {
            window.location.reload();
        });
    }

    // ─── TOKEN FUNCTIONS ───
    function loadTokens() {
        fetch('/api/tokens').then(r => r.json()).then(data => {
            const list = document.getElementById('tokenList');
            if (!data || data.length === 0) {
                list.innerHTML = '<div style="color:#444; text-align:center; padding:10px;">No tokens.</div>';
                return;
            }
            list.innerHTML = data.map(t => `
                <div class="token-item">
                    <span>${t.token ? t.token.substring(0, 15) + '...' : 'Invalid'}</span>
                    <span style="color:#888;">${t.owner || 'default'}</span>
                    <span class="status ${t.enabled ? 'on' : 'off'}">${t.enabled ? 'ON' : 'OFF'}</span>
                    <div>
                        <button class="btn" onclick="toggleToken(${t.id})">↕</button>
                        <button class="btn danger" onclick="deleteToken(${t.id})">✕</button>
                    </div>
                </div>
            `).join('');
            document.getElementById('tokenCount').textContent = data.length;
            document.getElementById('statTokens').textContent = data.length;
            document.getElementById('statEnabled').textContent = data.filter(t => t.enabled).length;
            document.getElementById('enabledCount').textContent = data.filter(t => t.enabled).length;
        });
    }

    function addToken() {
        const token = document.getElementById('tokenInput').value.trim();
        const owner = document.getElementById('ownerInput').value.trim() || 'default';
        if (!token) return alert('❌ Enter token!');
        fetch('/api/tokens/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, owner })
        })
        .then(r => r.json()).then(data => {
            if (data.success) {
                document.getElementById('tokenInput').value = '';
                loadTokens();
                addLog('✅ Token added: ' + owner);
            }
        });
    }

    function deleteToken(id) {
        if (!confirm('Delete this token?')) return;
        fetch('/api/tokens/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
        }).then(() => loadTokens());
    }

    function toggleToken(id) {
        fetch('/api/tokens/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
        }).then(() => loadTokens());
    }

    function clearAll() {
        if (!confirm('⚠️ Delete ALL tokens?')) return;
        fetch('/api/tokens/clear', { method: 'POST' }).then(() => {
            loadTokens();
            loadStats();
            addLog('🗑️ All tokens cleared');
        });
    }

    // ─── INFINITE BULK ADD ───
    function bulkAdd() {
        const text = document.getElementById('bulkTokensInput').value;
        const defaultOwner = document.getElementById('bulkOwnerInput').value.trim() || 'default';
        const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 5);
        
        if (lines.length === 0) {
            alert('❌ No tokens found!');
            return;
        }

        // Extract tokens from each line
        const tokens = [];
        lines.forEach(line => {
            let token = line;
            // If line contains comma, split
            if (line.includes(',')) {
                const parts = line.split(',');
                token = parts[0].trim();
            }
            // Remove quotes
            token = token.replace(/["']/g, '').trim();
            if (token.length > 10) {
                tokens.push(token);
            }
        });

        if (tokens.length === 0) {
            alert('❌ No valid tokens detected!');
            return;
        }

        if (!confirm(`Detected ${tokens.length} tokens. Add them?`)) return;

        const progress = document.getElementById('bulkProgress');
        const result = document.getElementById('bulkResult');
        progress.style.display = 'block';
        progress.textContent = `⏳ Adding ${tokens.length} tokens...`;
        progress.style.color = '#ff8800';

        fetch('/api/tokens/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokens, owner: defaultOwner })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                progress.textContent = `✅ Added ${data.added}/${data.total} tokens! (${data.failed} failed)`;
                progress.style.color = data.added === data.total ? '#00ff88' : '#ff8800';
                result.textContent = data.results ? data.results.map(r => `${r.token} ${r.status}`).join(' | ') : '';
                document.getElementById('bulkTokensInput').value = '';
                loadTokens();
                loadStats();
                addLog(`📦 Bulk added ${data.added} tokens`);
            } else {
                progress.textContent = '❌ Failed to add tokens';
                progress.style.color = '#ff0040';
            }
        });
    }

    function bulkAddAndStart() {
        const text = document.getElementById('bulkTokensInput').value;
        const defaultOwner = document.getElementById('bulkOwnerInput').value.trim() || 'default';
        const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 5);
        
        if (lines.length === 0) {
            alert('❌ No tokens found!');
            return;
        }

        const tokens = [];
        lines.forEach(line => {
            let token = line;
            if (line.includes(',')) {
                const parts = line.split(',');
                token = parts[0].trim();
            }
            token = token.replace(/["']/g, '').trim();
            if (token.length > 10) {
                tokens.push(token);
            }
        });

        if (tokens.length === 0) {
            alert('❌ No valid tokens detected!');
            return;
        }

        if (!confirm(`Detected ${tokens.length} tokens. Add and start all?`)) return;

        const progress = document.getElementById('bulkProgress');
        progress.style.display = 'block';
        progress.textContent = `⏳ Adding ${tokens.length} tokens...`;
        progress.style.color = '#ff8800';

        fetch('/api/tokens/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokens, owner: defaultOwner })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                progress.textContent = `✅ Added ${data.added}/${data.total} tokens! Starting...`;
                progress.style.color = '#00ff88';
                document.getElementById('bulkTokensInput').value = '';
                loadTokens();
                loadStats();
                addLog(`📦 Bulk added ${data.added} tokens, starting all...`);
                // Start all bots
                setTimeout(() => {
                    fetch('/api/tokens/start', { method: 'POST' });
                    addLog('🚀 Starting all bots...');
                }, 1000);
            } else {
                progress.textContent = '❌ Failed to add tokens';
                progress.style.color = '#ff0040';
            }
        });
    }

    // ─── START/STOP ───
    function startAll() {
        fetch('/api/tokens/start', { method: 'POST' });
        document.getElementById('onlineCount').textContent = '⏳';
        addLog('🚀 Starting bots...');
    }

    function stopAll() {
        if (!confirm('Stop all bots?')) return;
        fetch('/api/tokens/stop', { method: 'POST' });
        document.getElementById('onlineCount').textContent = '0';
        addLog('🛑 All bots stopped');
    }

    // ─── VC JOIN ───
    function joinVC() {
        const channel = document.getElementById('vcChannel').value.trim();
        if (!channel) return alert('❌ Enter Channel ID!');
        document.getElementById('vcStatus').textContent = '⏳ Joining...';
        fetch('/api/joinvc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ channelId: channel })
        })
        .then(r => r.json()).then(data => {
            if (data.success) {
                document.getElementById('vcStatus').textContent = `✅ ${data.connected || 0} bots joined VC!`;
                addLog(`🔊 Joined VC: ${channel}`);
            } else {
                document.getElementById('vcStatus').textContent = '❌ Failed: ' + (data.error || '');
            }
        });
    }

    // ─── STATS ───
    function loadStats() {
        fetch('/api/stats').then(r => r.json()).then(s => {
            document.getElementById('statTokens').textContent = s.tokens || 0;
            document.getElementById('statEnabled').textContent = s.enabled || 0;
            document.getElementById('statOnline').textContent = s.online || 0;
            document.getElementById('onlineCount').textContent = s.online || 0;
            document.getElementById('enabledCount').textContent = s.enabled || 0;
        });
    }

    function addLog(msg) {
        const logs = document.getElementById('logs');
        const time = new Date().toLocaleTimeString();
        logs.innerHTML += `<div>[${time}] ${msg}</div>`;
        logs.scrollTop = logs.scrollHeight;
        if (logs.children.length > 30) { logs.removeChild(logs.firstChild); }
    }

    // ─── SOCKET ───
    socket.on('stats', (data) => {
        if (data.online !== undefined) {
            document.getElementById('statOnline').textContent = data.online;
            document.getElementById('onlineCount').textContent = data.online;
        }
        if (data.tokens !== undefined) {
            document.getElementById('statTokens').textContent = data.tokens;
            document.getElementById('tokenCount').textContent = data.tokens;
        }
        if (data.enabled !== undefined) {
            document.getElementById('statEnabled').textContent = data.enabled;
            document.getElementById('enabledCount').textContent = data.enabled;
        }
    });

    socket.on('log', (data) => {
        const logs = document.getElementById('logs');
        logs.innerHTML += `<div>[${data.time}] ${data.message}</div>`;
        logs.scrollTop = logs.scrollHeight;
        if (logs.children.length > 30) { logs.removeChild(logs.firstChild); }
    });

    // ─── INIT ───
    loadTokens();
    loadStats();
    setInterval(loadStats, 3000);
    console.log('👑 RINTU INFINITE TOKENS LOADED');
</script>
</body>
</html>
